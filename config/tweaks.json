{
  "CMEToggleClassicMenu": {
    "Content": "Classic right-click menu",
    "Description": "Always show the full menu on Windows 11, without clicking \"Show more options\".",
    "category": "Windows 11",
    "Type": "Toggle",
    "RestartExplorer": true,
    "InvokeScript": ["Set-ClassicMenu $true"],
    "UndoScript": ["Set-ClassicMenu $false"],
    "DetectScript": "Test-ClassicMenu",
    "UnavailableScript": "if (-not $App.IsWin11) { 'Only applies to Windows 11; this PC already uses the classic menu.' }"
  },
  "CMETweaksHideGiveAccess": {
    "Content": "Remove \"Give access to\"",
    "Description": "Network sharing entry on files, folders and drives (ntshrui.dll).",
    "category": "Clean up the menu",
    "RestartExplorer": true,
    "registry": [
      { "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Shell Extensions\\Blocked", "Name": "{f81e9010-6ea4-11ce-a7ff-00aa003ca9f6}", "Value": "", "Type": "String", "OriginalValue": "<RemoveEntry>" }
    ]
  },
