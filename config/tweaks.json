  "CMETweaksAddVSCode": {
    "Content": "Add \"Open with Code\"",
    "Description": "VS Code on files, folders and folder background.",
    "category": "Add useful entries",
    "InvokeScript": ["Install-Preset 'vscode'"],
    "UndoScript": ["Uninstall-Preset 'vscode'"],
    "DetectScript": "Test-PresetInstalled 'vscode' (Get-PresetSpec 'vscode')",
    "UnavailableScript": "if (-not (Find-VSCode)) { 'VS Code was not found' }"
  },
