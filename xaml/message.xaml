<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1B1C1F" Foreground="#EEEEEC" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!--RES-->
    </Window.Resources>
    <StackPanel>
        <StackPanel Margin="26,22,26,22">
            <TextBlock x:Name="MsgTitle" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
            <TextBlock x:Name="MsgText" Foreground="#A2A5AB" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
        </StackPanel>
        <Border Background="#151618" BorderBrush="#2A2B2F" BorderThickness="0,1,0,0" Padding="26,12">
            <StackPanel x:Name="MsgButtons" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </StackPanel>
</Window>
