<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Context Menu Editor" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1B1C1F" Foreground="#EEEEEC" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!--RES-->
    </Window.Resources>
    <StackPanel>
        <StackPanel Margin="28,26,28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AboutIcon" Width="64" Height="64" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Context Menu Editor" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="AboutVersion" Foreground="#A2A5AB" Margin="0,3,0,0"/>
                    <Image x:Name="AboutWordmark" Height="14" HorizontalAlignment="Left" Margin="0,10,0,0" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.85"/>
                </StackPanel>
            </Grid>

            <TextBlock Foreground="#A2A5AB" TextWrapping="Wrap" LineHeight="20" Margin="0,20,0,0"
                       Text="Shows every right-click entry Windows knows about, so you can turn entries off, edit them, add your own and tidy up Send to and New. Anything you delete or edit is backed up first, and the last change can be undone."/>

            <TextBlock Text="Run it from PowerShell" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#151618" BorderBrush="#2A2B2F" BorderThickness="1" CornerRadius="7" Padding="12,8">
                    <TextBox x:Name="AboutLaunch" Style="{StaticResource ReadOnlyText}" FontFamily="{StaticResource Mono}" FontSize="12.5" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="AboutCopy" Grid.Column="1" Content="Copy" Style="{StaticResource Btn}" Margin="10,0,0,0"/>
            </Grid>
            <TextBlock Text="The command always downloads the latest version." FontSize="12" Foreground="#7A7D83" Margin="0,6,0,0"/>

            <Border BorderBrush="#2A2B2F" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
                <Grid x:Name="AboutFacts">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </StackPanel>
        <Border Background="#151618" BorderBrush="#2A2B2F" BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel>
                <Button x:Name="AboutClose" DockPanel.Dock="Right" Content="Close" Style="{StaticResource Btn}" MinWidth="86" IsCancel="True" IsDefault="True"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AboutSource" Content="Source code" Style="{StaticResource BtnGhost}" ToolTip="github.com/RoeeIlouz/ROCIsContextMenu-Editor"/>
                    <Button x:Name="AboutSite" Content="rocisapps.com" Style="{StaticResource BtnGhost}" Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
